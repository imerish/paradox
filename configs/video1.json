{
    "video_path": "./videos/Bag Thief Caught on Camera at A Coffee Shop.mp4",
    "model_path": "yolo11n-pose.pt",
    "output_dir": "./results",

    "yolo": {
        "conf": 0.06,
        "iou": 0.5,
        "imgsz": 640
